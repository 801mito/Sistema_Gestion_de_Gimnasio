<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gt.edu.gimnasio.controller.MembershipsController">
    <padding>
        <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
    </padding>
    <Label styleClass="content-title" text="Membresías" />
    <Label styleClass="content-description" text="Asigna planes activos y consulta el historial de membresías." />
    <VBox spacing="12.0" styleClass="information-card">
        <Label styleClass="card-title" text="Asignar membresía" />
        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Miembro" />
                <ComboBox fx:id="memberComboBox" maxWidth="1.7976931348623157E308" promptText="Selecciona un miembro" />
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Plan activo" />
                <ComboBox fx:id="planComboBox" maxWidth="1.7976931348623157E308" promptText="Selecciona un plan" />
            </VBox>
            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Fecha de inicio" />
                <DatePicker fx:id="startDatePicker" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#assignMembership" styleClass="primary-button" text="Asignar" />
        </HBox>
        <Label fx:id="endDateLabel" styleClass="card-message" text="Selecciona un plan y una fecha de inicio." />
    </VBox>
    <Label fx:id="feedbackLabel" managed="false" visible="false" wrapText="true" />
    <TableView fx:id="membershipsTable" prefHeight="400.0" styleClass="memberships-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID" />
            <TableColumn fx:id="memberColumn" prefWidth="240.0" text="Miembro" />
            <TableColumn fx:id="planColumn" prefWidth="180.0" text="Plan" />
            <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Estado" />
            <TableColumn fx:id="startDateColumn" prefWidth="140.0" text="Fecha inicio" />
            <TableColumn fx:id="endDateColumn" prefWidth="140.0" text="Fecha final" />
        </columns>
    </TableView>
</VBox>
