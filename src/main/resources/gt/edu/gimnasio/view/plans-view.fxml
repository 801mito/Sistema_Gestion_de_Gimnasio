<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gt.edu.gimnasio.controller.PlansController">
    <padding>
        <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
    </padding>
    <Label styleClass="content-title" text="Planes" />
    <Label styleClass="content-description" text="Registra y consulta los planes de membresía disponibles." />
    <VBox spacing="12.0" styleClass="information-card">
        <Label styleClass="card-title" text="Registrar o editar plan" />
        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Nombre" />
                <TextField fx:id="nameField" promptText="Ej.: Mensual" />
            </VBox>
            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Duración (días)" />
                <Spinner fx:id="durationSpinner" editable="true" prefWidth="150.0" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#savePlan" styleClass="primary-button" text="Guardar plan" />
            <Button fx:id="updateButton" disable="true" mnemonicParsing="false" onAction="#updatePlan" styleClass="secondary-button" text="Actualizar plan" />
        </HBox>
        <HBox spacing="10.0">
            <Button fx:id="activateButton" disable="true" mnemonicParsing="false" onAction="#activatePlan" styleClass="secondary-button" text="Activar" />
            <Button fx:id="deactivateButton" disable="true" mnemonicParsing="false" onAction="#deactivatePlan" styleClass="danger-button" text="Desactivar" />
            <Button mnemonicParsing="false" onAction="#clearForm" styleClass="link-button" text="Limpiar selección" />
        </HBox>
        <Label fx:id="feedbackLabel" managed="false" visible="false" wrapText="true" />
    </VBox>
    <Label styleClass="card-title" text="Planes registrados" />
    <TableView fx:id="plansTable" prefHeight="300.0" styleClass="plans-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="100.0" text="ID" />
            <TableColumn fx:id="nameColumn" prefWidth="300.0" text="Nombre" />
            <TableColumn fx:id="durationColumn" prefWidth="180.0" text="Duración (días)" />
            <TableColumn fx:id="statusColumn" prefWidth="160.0" text="Estado" />
        </columns>
    </TableView>
</VBox>
