<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gt.edu.gimnasio.controller.MembersController">
    <padding>
        <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
    </padding>
    <Label styleClass="content-title" text="Miembros" />
    <Label styleClass="content-description" text="Registra y consulta las personas inscritas en el gimnasio." />
    <VBox spacing="12.0" styleClass="information-card">
        <Label styleClass="card-title" text="Registrar miembro" />
        <HBox spacing="12.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Nombres *" />
                <TextField fx:id="firstNamesField" promptText="Ej.: Jaime David" />
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Apellidos *" />
                <TextField fx:id="lastNamesField" promptText="Ej.: Cardona Marmol" />
            </VBox>
        </HBox>
        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Documento" />
                <TextField fx:id="documentField" promptText="Opcional" />
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Teléfono" />
                <TextField fx:id="phoneField" promptText="Opcional" />
            </VBox>
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Correo" />
                <TextField fx:id="emailField" promptText="Opcional" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#saveMember" styleClass="primary-button" text="Guardar miembro" />
        </HBox>
        <Label fx:id="feedbackLabel" managed="false" visible="false" wrapText="true" />
    </VBox>
    <TableView fx:id="membersTable" prefHeight="400.0" styleClass="members-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID" />
            <TableColumn fx:id="firstNamesColumn" prefWidth="170.0" text="Nombres" />
            <TableColumn fx:id="lastNamesColumn" prefWidth="170.0" text="Apellidos" />
            <TableColumn fx:id="documentColumn" prefWidth="150.0" text="Documento" />
            <TableColumn fx:id="phoneColumn" prefWidth="130.0" text="Teléfono" />
            <TableColumn fx:id="emailColumn" prefWidth="220.0" text="Correo" />
        </columns>
    </TableView>
</VBox>
