<a:Modifier>jaime</a:Modifier>
<a:Comment>Verifica las credenciales de la cuenta y obtiene el gimnasio activo asociado. No expone la contrasena ni su hash.</a:Comment>
<a:GlobalObjectID/>
<a:NumberID>6</a:NumberID>
<a:ActionType>&lt;Undefined&gt;</a:ActionType>
</o:Process>
